# ==========================================
# 1. Секретні дані та конфігурації (КРИТИЧНО)
# ==========================================
.env
*.secret
secrets.json
# Залишаємо .env.example для розуміння структури змінних
!.env.example

# ==========================================
# 2. Python та віртуальні середовища
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# 3. Кеш тестування та покриття коду
# ==========================================
.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ==========================================
# 4. Локальні дані Docker та Бази Даних
# ==========================================
# Папки, куди Docker монтуватиме дані PostgreSQL
pgdata/
postgres_data/
db_data/

# ==========================================
# 5. Специфічні файли AI Asset Manager
# ==========================================
# Важкі ваги моделей (чекпойнти, LoRA), які важать гігабайти
models/
checkpoints/
loras/
embeddings/

# Згенерований контент та тимчасові файли
assets/generated/
temp_generations/
*.png
*.jpg
*.mp3
*.wav
*.mp4
# Виняток: якщо в assets є базові логотипи чи іконкиUI
!assets/ui/

# ==========================================
# 6. Файли IDE та операційної системи
# ==========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
